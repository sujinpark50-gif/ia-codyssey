// Firestore 보안 규칙 — 브라우저(클라이언트 SDK)의 직접 접근을 모두 막는다.
// 서버는 서비스 계정(Admin SDK)으로 접근하므로 이 규칙의 영향을 받지 않는다.
// 적용: Firebase 콘솔 → Firestore → 규칙 (현재 콘솔 설정과 같은지 확인 후 적용)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
