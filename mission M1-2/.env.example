# 복사해서 .env 로 쓰세요. .env 와 서비스 계정 키는 커밋하지 않습니다.

# memory: 로컬 메모리 저장소 (data/ugv_speed_1s.json 을 시작 시 적재) / firestore: 실제 Firestore
DATA_BACKEND=memory
SEED_ON_STARTUP=true
# SEED_DATA_PATH=data/ugv_speed_1s.json
# QUALITY_SUMMARY_PATH=data/validation_summary.json

# Firestore (DATA_BACKEND=firestore 일 때만). 키 파일은 저장소 밖에 둡니다.
# FIREBASE_CREDENTIALS=C:/secrets/adair-mi-service-account.json
# FIREBASE_PROJECT_ID=
# FIRESTORE_DATA_COLLECTION=data
# FIRESTORE_CONVERSATIONS_COLLECTION=conversations

# 허용할 프론트엔드 출처 (쉼표 구분). 비우면 어떤 출처도 허용하지 않습니다.
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
