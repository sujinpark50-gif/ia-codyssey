
# M3 GPT 분석 비서 (OpenAI 호환 API). 키는 .env 에만, 커밋 금지
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# OPENAI_TIMEOUT_S=30
# OPENAI_MAX_OUTPUT_TOKENS=800
# CHAT_HISTORY_MAX_MESSAGES=10     # GPT 에 보내는 이전 메시지 최대 개수
# CHAT_HISTORY_MAX_CHARS=8000      # 이전 메시지 글자 수 상한 (오래된 것부터 뺌)
# SUMMARY_CACHE_TTL_S=60           # 통계 캐시 유지 시간, 0 이면 캐시 없음

# M4 로그인 (Firebase Authentication · Google). 웹 설정값은 공개 식별자이며 비밀이 아닙니다.
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
# FIREBASE_WEB_APP_ID=
# 허용할 Google 계정 (쉼표 구분). 비우면 아무도 사용할 수 없습니다.
# ALLOWED_EMAILS=

# M4 질문 제한 (GPT 호출)
# CHAT_RATE_PER_MINUTE=5
# CHAT_RATE_PER_HOUR=30
# CHAT_MAX_CONCURRENT=1
# CHAT_DAILY_LIMIT=200              # 전체 일일 상한. firestore 백엔드에서는 usage/{KST 날짜} 에 저장되어 재시작 후에도 유지
# MAX_REQUEST_BYTES=16384
# MAX_CONVERSATIONS_PER_USER=100
# MAX_MESSAGES_PER_CONVERSATION=200
# DOCS_ENABLED=true                 # 운영에서는 false
