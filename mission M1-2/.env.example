
# M3 GPT 분석 비서 (OpenAI 호환 API). 키는 .env 에만, 커밋 금지
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
# OPENAI_TIMEOUT_S=30
# OPENAI_MAX_OUTPUT_TOKENS=800
# CHAT_HISTORY_MAX_MESSAGES=10     # GPT 에 보내는 이전 메시지 최대 개수
# CHAT_HISTORY_MAX_CHARS=8000      # 이전 메시지 글자 수 상한 (오래된 것부터 뺌)
# SUMMARY_CACHE_TTL_S=60           # 통계 캐시 유지 시간, 0 이면 캐시 없음
